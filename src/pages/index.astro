---
import { getCollection } from "astro:content";
import { marked } from "marked";
import NewsCard from "../components/NewsCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsEntryLayout from "../layouts/NewsEntryLayout.astro";

const newsPosts = (await getCollection("news", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

if (newsPosts.length === 0) {
  throw new Error("No published entries found in src/content/news.");
}

const [latestPost, ...previousPosts] = newsPosts;
const { Content } = await latestPost.render();

marked.use({ gfm: true, breaks: false });

const parsedItems = Array.from(
  latestPost.body.matchAll(/##\s+(.+?)\r?\n\r?\n([\s\S]*?)(?=(\r?\n##\s+)|$)/g),
).map((match, index) => ({
  index: index + 1,
  title: match[1].trim(),
  descriptionHtml: marked.parse(match[2].trim()).replace(/^<p>|<\/p>\n?$/g, ""),
}));
---

<BaseLayout title="Latest Weekly Brief" description={latestPost.data.description}>
  <NewsEntryLayout
    title={latestPost.data.title}
    weekNumber={latestPost.data.weekNumber}
    pubDate={latestPost.data.pubDate}
    summary={latestPost.data.summary}
    contentClass="mt-6 grid grid-cols-1 gap-4"
  >
    {
      parsedItems.length > 0 ? (
        <div class="space-y-4">
          {parsedItems.map((item) => (
            <article class="relative rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition duration-200 ease-out hover:-translate-y-0.5 hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
              <label class="absolute right-4 top-4 z-10 flex cursor-pointer items-center gap-2 rounded-full bg-slate-100 px-3 py-1 text-xs font-bold text-slate-600 shadow-sm dark:bg-slate-700 dark:text-slate-200">
                <input type="checkbox" name="selected-items" value={item.index} class="item-checkbox accent-blue-600" />
                <span class="pointer-events-none">{item.index}</span>
              </label>
              <h3 class="font-serif text-xl font-semibold text-slate-900 dark:text-slate-100">{item.title}</h3>
              <div class="news-content mt-3 text-base leading-7 text-slate-700 dark:text-slate-300" set:html={item.descriptionHtml} />
            </article>
          ))}
          <div class="mt-8 rounded-xl bg-slate-100 p-4 dark:bg-slate-800">
            <h4 class="text-sm font-bold text-slate-700 dark:text-slate-300">Selected Items:</h4>
            <div id="selected-list" class="mt-2 text-lg font-mono text-slate-900 dark:text-white">-</div>
          </div>
        </div>
      ) : (
        <div class="prose prose-slate max-w-none lg:prose-xl dark:prose-invert">
          <Content />
        </div>
      )
    }
    <script>
      const checkboxes = document.querySelectorAll('.item-checkbox');
      const selectedList = document.getElementById('selected-list');

      checkboxes.forEach(cb => {
        cb.addEventListener('change', () => {
          const selected = Array.from(checkboxes)
            .filter(c => c.checked)
            .map(c => c.value);
          selectedList.textContent = selected.length > 0 ? selected.join(', ') : '-';
        });
      });
    </script>
  </NewsEntryLayout>

  <section id="previous-weeks" class="mt-14">
    <h2 class="font-serif text-2xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">
      Previous Weeks
    </h2>
    {
      previousPosts.length > 0 ? (
        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {previousPosts.map((post) => (
            <NewsCard
              slug={post.slug}
              title={post.data.title}
              weekNumber={post.data.weekNumber}
              pubDate={post.data.pubDate}
            />
          ))}
        </div>
      ) : (
        <p class="mt-4 text-sm text-slate-600 dark:text-slate-300">No previous weeks yet.</p>
      )
    }
  </section>
</BaseLayout>
